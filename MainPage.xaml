<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="DDepartures.MainPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:local="clr-namespace:DDepartures">
	<ContentPage.Resources>
		<local:DepartureStateToColorConverter x:Key="StateToColorConverter" />
		<local:DepartureMetaConverter x:Key="DepartureMetaConverter" />
	</ContentPage.Resources>

	<Grid
		Padding="0,0,0,0"
		BackgroundColor="{AppThemeBinding Light={StaticResource Background},
		                                  Dark={StaticResource BackgroundDark}}"
		ColumnDefinitions="*"
		RowDefinitions="Auto, *, Auto, Auto">
		<Grid
			x:Name="TopRow"
			Grid.Row="0"
			ColumnDefinitions="*"
			RowDefinitions="8, Auto, 8">
			<BoxView Grid.Row="0" BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
			<Image
				Grid.Row="1"
				Aspect="AspectFit"
				BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
				                                  Dark={StaticResource PrimaryDark}}"
				HeightRequest="32"
				SemanticProperties.Description="vvo logo"
				Source="vvologo.png" />
			<BoxView Grid.Row="2" BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
		</Grid>

		<!--  Departures list (starts invisible)  -->
		<RefreshView
			x:Name="RefView"
			Grid.Row="1"
			Padding="12,0,12,0"
			Focused="OnUnfocused"
			IsRefreshing="{Binding DeparturesRefreshing, Mode=TwoWay}"
			IsVisible="False"
			RefreshColor="{AppThemeBinding Light={StaticResource Primary},
			                               Dark={StaticResource PrimaryDark}}">
			<RefreshView.GestureRecognizers>
				<TapGestureRecognizer
					Buttons="Primary, Secondary"
					NumberOfTapsRequired="1"
					Tapped="OnTapped" />
			</RefreshView.GestureRecognizers>
			<CollectionView
				x:Name="DepartureListView"
				Focused="OnUnfocused"
				ItemsSource="{Binding DepItems}"
				SelectionMode="None">
				<CollectionView.ItemTemplate>
					<DataTemplate>
						<Grid
							Padding="0,0,0,0"
							ColumnDefinitions="2, 4, Auto, 4, 8, *, 8, Auto, Auto, 2"
							RowDefinitions="6, Auto, Auto, 6, 2">
							<Grid.GestureRecognizers>
								<TapGestureRecognizer
									Buttons="Primary, Secondary"
									NumberOfTapsRequired="1"
									Tapped="OnTapped" />
							</Grid.GestureRecognizers>
							<BoxView
								Grid.Row="0"
								Grid.ColumnSpan="10"
								BackgroundColor="{AppThemeBinding Light={StaticResource Background},
								                                  Dark={StaticResource BackgroundDark}}" />
							<BoxView
								Grid.Row="1"
								Grid.RowSpan="2"
								Grid.Column="0"
								BackgroundColor="{AppThemeBinding Light={StaticResource Background},
								                                  Dark={StaticResource BackgroundDark}}" />
							<BoxView
								Grid.Row="1"
								Grid.RowSpan="2"
								Grid.Column="1"
								BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
								                                  Dark={StaticResource PrimaryDark}}" />
							<ScrollView
								Grid.Row="1"
								Grid.RowSpan="2"
								Grid.Column="2"
								BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
								                                  Dark={StaticResource PrimaryDark}}"
								HorizontalScrollBarVisibility="Never"
								MaximumWidthRequest="84"
								Orientation="Horizontal"
								VerticalOptions="Fill">
								<Label
									x:Name="LineLabel"
									Padding="0"
									BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
									                                  Dark={StaticResource PrimaryDark}}"
									FontAttributes="Bold"
									FontFamily="CascadiaCode"
									FontSize="18"
									Text="{Binding Line}"
									TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
									                            Dark={StaticResource Black}}"
									VerticalOptions="Center"
									VerticalTextAlignment="Center" />
							</ScrollView>
							<BoxView
								Grid.Row="1"
								Grid.RowSpan="2"
								Grid.Column="3"
								BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
								                                  Dark={StaticResource PrimaryDark}}" />
							<BoxView
								Grid.Row="1"
								Grid.RowSpan="2"
								Grid.Column="4"
								BackgroundColor="{AppThemeBinding Light={StaticResource Background},
								                                  Dark={StaticResource BackgroundDark}}" />
							<ScrollView
								Grid.Row="1"
								Grid.Column="5"
								HorizontalScrollBarVisibility="Never"
								Orientation="Horizontal">
								<Label
									x:Name="DestinationLabel"
									Padding="0"
									FontFamily="CascadiaCode"
									FontSize="18"
									HorizontalOptions="Start"
									Text="{Binding Destination}"
									VerticalTextAlignment="Center" />
							</ScrollView>
							<BoxView
								Grid.Row="1"
								Grid.RowSpan="2"
								Grid.Column="6"
								BackgroundColor="{AppThemeBinding Light={StaticResource Background},
								                                  Dark={StaticResource BackgroundDark}}" />
							<Label
								x:Name="TimeLabel"
								Grid.Row="1"
								Grid.RowSpan="2"
								Grid.Column="7"
								Padding="0,2,0,0"
								CharacterSpacing="2"
								FontFamily="London"
								FontSize="20"
								HorizontalOptions="Center"
								Text="{Binding Time}"
								TextColor="{Binding State, Converter={StaticResource StateToColorConverter}}"
								VerticalTextAlignment="Center" />
							<Label
								x:Name="ApostropheLabel"
								Grid.Row="1"
								Grid.RowSpan="2"
								Grid.Column="8"
								Padding="2,2,0,0"
								FontFamily="London"
								FontSize="20"
								HorizontalOptions="End"
								Text="'"
								TextColor="{AppThemeBinding Light={StaticResource Primary},
								                            Dark={StaticResource PrimaryDark}}"
								VerticalTextAlignment="Center" />
							<BoxView
								Grid.Row="1"
								Grid.RowSpan="2"
								Grid.Column="9"
								BackgroundColor="{AppThemeBinding Light={StaticResource Background},
								                                  Dark={StaticResource BackgroundDark}}" />
							<BoxView
								Grid.Row="2"
								Grid.Column="5"
								BackgroundColor="{AppThemeBinding Light={StaticResource Background},
								                                  Dark={StaticResource BackgroundDark}}" />
							<ScrollView
								Grid.Row="2"
								Grid.Column="5"
								HorizontalScrollBarVisibility="Never"
								Orientation="Horizontal">
								<Label
									x:Name="MetaLabel"
									Padding="0,0,0,0"
									FontFamily="CascadiaCode"
									FontSize="12"
									LineBreakMode="NoWrap"
									Opacity="0.8"
									TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
									                            Dark={StaticResource TextPrimaryDark}}"
									VerticalTextAlignment="Center">
									<Label.Text>
										<MultiBinding Converter="{StaticResource DepartureMetaConverter}">
											<Binding Path="Mot" />
											<Binding Path="Platform" />
											<Binding Path="Occupancy" />
										</MultiBinding>
									</Label.Text>
								</Label>
							</ScrollView>

							<BoxView
								Grid.Row="3"
								Grid.ColumnSpan="10"
								BackgroundColor="{AppThemeBinding Light={StaticResource Background},
								                                  Dark={StaticResource BackgroundDark}}" />
							<BoxView
								Grid.Row="4"
								Grid.ColumnSpan="10"
								BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
								                                  Dark={StaticResource PrimaryDark}}" />
						</Grid>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</RefreshView>

		<!--  PointFinder results CollectionView (starts invisible)  -->
		<CollectionView
			x:Name="PointFinderView"
			Grid.Row="1"
			IsVisible="False"
			ItemsSource="{Binding PointResults}"
			SelectionMode="Single"
			VerticalOptions="End">
			<CollectionView.GestureRecognizers>
				<TapGestureRecognizer
					Buttons="Primary, Secondary"
					NumberOfTapsRequired="1"
					Tapped="OnTapped" />
			</CollectionView.GestureRecognizers>

			<CollectionView.ItemTemplate>
				<DataTemplate>
					<!--  One row per result, three columns: City | Name | Id  -->
					<Grid Padding="8,6" ColumnDefinitions="Auto,*,Auto">
						<Label
							Grid.Column="0"
							FontFamily="CascadiaCode"
							FontSize="18"
							LineBreakMode="TailTruncation"
							Text="{Binding City}"
							VerticalTextAlignment="Center" />
						<Label
							Grid.Column="1"
							FontFamily="CascadiaCode"
							FontSize="18"
							HorizontalTextAlignment="Start"
							LineBreakMode="TailTruncation"
							Text="{Binding Name}"
							VerticalTextAlignment="Center" />
						<Label
							Grid.Column="2"
							FontFamily="London"
							FontSize="16"
							HorizontalTextAlignment="End"
							Text="{Binding Id}"
							VerticalTextAlignment="Center" />
					</Grid>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

		<Grid
			Grid.Row="2"
			Padding="16,8,16,8"
			ColumnDefinitions="Auto, *"
			ColumnSpacing="8">
			<Label
				Grid.Column="0"
				FontSize="12"
				Text="Status:" />
			<Label
				x:Name="StatusLabel"
				Grid.Column="1"
				FontAttributes="Bold"
				FontSize="12"
				Text="{Binding StatusResponse}" />
		</Grid>

		<Grid
			x:Name="BottomRow"
			Grid.Row="3"
			Padding="8,0,8,8"
			ColumnDefinitions="*, Auto, Auto"
			ColumnSpacing="8"
			RowDefinitions="Auto">
			<Entry
				x:Name="SearchEntry"
				Grid.Column="0"
				ClearButtonVisibility="WhileEditing"
				Completed="OnSearchClicked"
				Focused="OnFocused"
				FontFamily="CascadiaCode"
				FontSize="18"
				Placeholder="Stop name or ID"
				ReturnType="Search"
				SemanticProperties.Hint="Station"
				TextChanged="OnTextChanged"
				Unfocused="OnUnfocused" />
			<Button
				x:Name="SearchBtn"
				Grid.Column="1"
				AutomationProperties.HelpText="Search"
				Clicked="OnSearchClicked"
				FontFamily="{OnPlatform WinUI='Segoe UI Emoji',
				                        Android='Noto Color Emoji',
				                        iOS='Apple Color Emoji'}"
				FontSize="18"
				SemanticProperties.Hint="Look for departures at station"
				Text="🔍" />
			<Button
				x:Name="FindBtn"
				Grid.Column="2"
				AutomationProperties.HelpText="Find"
				Clicked="OnFindClicked"
				FontFamily="{OnPlatform WinUI='Segoe UI Emoji',
				                        Android='Noto Color Emoji',
				                        iOS='Apple Color Emoji'}"
				FontSize="18"
				SemanticProperties.Hint="Find station using PointFinder"
				Text="📍" />
		</Grid>
	</Grid>
</ContentPage>
