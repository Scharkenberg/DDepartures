<?xml version="1.0" encoding="utf-8"?>
<ContentPage
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:local="clr-namespace:DDepartures"
  x:Class="DDepartures.MainPage"
>
  <Grid
    RowDefinitions="Auto, *, Auto, Auto"
    ColumnDefinitions="*"
    Padding="0,0,0,0"
    BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}"
  >
	<Grid Grid.Row="0" x:Name="TopRow" RowDefinitions="8, Auto, 8" ColumnDefinitions="*">
	  <BoxView
        Grid.Row="0"
        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
      />
	  <Image
        Grid.Row="1"
        Source="vvologo.png"
        HeightRequest="32"
        Aspect="AspectFit"
        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
        SemanticProperties.Description="vvo logo"
      />
	  <BoxView
        Grid.Row="2"
        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
      />
	</Grid>

	<!-- Departures list (starts invisible) -->
	<RefreshView
      x:Name="RefView"
      Grid.Row="1"
      Padding="16,0,16,0"
      IsRefreshing="{Binding DeparturesRefreshing, Mode=TwoWay}"
      IsVisible="False"
      Focused="OnUnfocused"
      RefreshColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
      Command="{Binding Source={RelativeSource AncestorType={x:Type local:MainPage}}, Path=RefreshCommand}"
    >
	  <RefreshView.GestureRecognizers>
		<TapGestureRecognizer
          Tapped="OnTapped"
          Buttons="Primary, Secondary"
          NumberOfTapsRequired="1"
        />
	  </RefreshView.GestureRecognizers>
	  <CollectionView
        x:Name="DepartureListView"
        Focused="OnUnfocused"
        ItemsSource="{Binding DepItems}"
        SelectionMode="None"
      >
		<CollectionView.ItemTemplate>
		  <DataTemplate>
			<Grid
              Padding="0,0,0,0"
              RowDefinitions="6, Auto, 6, 2"
              ColumnDefinitions="2, 4, Auto, 4, 8, *, 8, Auto, Auto, 2"
            >
			  <Grid.GestureRecognizers>
				<TapGestureRecognizer
                  Tapped="OnTapped"
                  Buttons="Primary, Secondary"
                  NumberOfTapsRequired="1"
                />
			  </Grid.GestureRecognizers>
			  <BoxView
                Grid.Row="0"
                Grid.ColumnSpan="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}"
              />
			  <BoxView
                Grid.Row="1"
                Grid.Column="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}"
              />
			  <BoxView
                Grid.Row="1"
                Grid.Column="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
              />
			  <Label
                x:Name="LineLabel"
                Grid.Row="1"
                Grid.Column="2"
                Padding="0"
                FontFamily="CascadiaCode"
                FontSize="18"
                FontAttributes="Bold"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource Black}}"
                Text="{Binding [0]}"
                HorizontalOptions="Center"
                VerticalTextAlignment="Center"
              />
			  <BoxView
                Grid.Row="1"
                Grid.Column="3"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
              />
			  <BoxView
                Grid.Row="1"
                Grid.Column="4"
                BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}"
              />
			  <ScrollView
                Orientation="Horizontal"
                HorizontalScrollBarVisibility="Never"
                Grid.Row="1"
                Grid.Column="5">
				<Label
                  x:Name="DestinationLabel"
                  Padding="0"
                  FontFamily="CascadiaCode"
                  FontSize="18"
                  Text="{Binding [1]}"
                  HorizontalOptions="Start"
                  VerticalTextAlignment="Center"
                />
			  </ScrollView>
			  <BoxView
                Grid.Row="1"
                Grid.Column="6"
                BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}"
              />
			  <Label
                x:Name="TimeLabel"
                Grid.Row="1"
                Grid.Column="7"
                Padding="0,2,0,0"
                FontFamily="London"
                FontSize="16"
                Text="{Binding [2]}"
                CharacterSpacing="2"
                HorizontalOptions="Center"
                VerticalTextAlignment="Center"
              />
			  <Label
                x:Name="ApostropheLabel"
                Grid.Row="1"
                Grid.Column="8"
                Padding="2,2,0,0"
                FontFamily="London"
                FontSize="16"
                Text="'"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                HorizontalOptions="End"
                VerticalTextAlignment="Center"
              />
			  <BoxView
                Grid.Row="1"
                Grid.Column="9"
                BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}"
              />
			  <BoxView
                Grid.Row="2"
                Grid.ColumnSpan="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}"
              />
			  <BoxView
                Grid.Row="3"
                Grid.ColumnSpan="10"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
              />
			</Grid>
		  </DataTemplate>
		</CollectionView.ItemTemplate>
	  </CollectionView>
	</RefreshView>

	<!-- PointFinder results CollectionView (starts invisible) -->
	<CollectionView
      x:Name="PointFinderView"
      Grid.Row="1"
      IsVisible="False"
      ItemsSource="{Binding PointResults}"
      SelectionMode="Single"
	  VerticalOptions="End"
    >
	  <CollectionView.GestureRecognizers>
		<TapGestureRecognizer
          Tapped="OnTapped"
          Buttons="Primary, Secondary"
          NumberOfTapsRequired="1"
        />
	  </CollectionView.GestureRecognizers>

	  <CollectionView.ItemTemplate>
		<DataTemplate>
		  <!-- One row per result, three columns: City | Name | Id -->
		  <Grid Padding="8,6" ColumnDefinitions="Auto,*,Auto">
			<Label
              Grid.Column="0"
              Text="{Binding City}"
              FontFamily="CascadiaCode"
              FontSize="18"
              VerticalTextAlignment="Center"
              LineBreakMode="TailTruncation"
            />
			<Label
              Grid.Column="1"
              Text="{Binding Name}"
              FontFamily="CascadiaCode"
              FontSize="18"
              VerticalTextAlignment="Center"
              LineBreakMode="TailTruncation"
			  HorizontalTextAlignment="Start"
            />
			<Label
              Grid.Column="2"
              Text="{Binding Id}"
              FontFamily="London"
              FontSize="16"
              VerticalTextAlignment="Center"
              HorizontalTextAlignment="End"
            />
		  </Grid>
		</DataTemplate>
	  </CollectionView.ItemTemplate>
	</CollectionView>

	<Grid Grid.Row="2" Padding="16,8,16,8" ColumnSpacing="8" ColumnDefinitions="Auto, *">
	  <Label Grid.Column="0" FontSize="12" Text="Status:" />
	  <Label Grid.Column="1" FontSize="12" FontAttributes="Bold" x:Name="StatusLabel"
             Text="{Binding StatusResponse}" />
	</Grid>

	<Grid
      Grid.Row="3"
      Padding="8,0,8,8"
      ColumnSpacing="8"
      x:Name="BottomRow"
      RowDefinitions="Auto"
      ColumnDefinitions="*, Auto, Auto"
    >
	  <Entry
        Grid.Column="0"
        x:Name="SearchEntry"
        SemanticProperties.Hint="Station"
        ClearButtonVisibility="WhileEditing"
        Placeholder="Stop name or ID"
        FontFamily="CascadiaCode"
        FontSize="18"
        ReturnType="Search"
        Completed="OnSearchClicked"
        Unfocused="OnUnfocused"
        Focused="OnFocused"
		TextChanged="OnTextChanged"
      />
	  <Button
        Grid.Column="1"
        x:Name="SearchBtn"
        Text="🔍"
        FontSize="18"
        FontFamily="{OnPlatform WinUI='Segoe UI Emoji', Android='Noto Color Emoji', iOS='Apple Color Emoji'}"
        SemanticProperties.Hint="Look for departures at station"
		AutomationProperties.HelpText="Search"
        Clicked="OnSearchClicked"
      />
	  <Button
        Grid.Column="2"
        x:Name="FindBtn"
        Text="📍"
        FontSize="18"
        FontFamily="{OnPlatform WinUI='Segoe UI Emoji', Android='Noto Color Emoji', iOS='Apple Color Emoji'}"
        SemanticProperties.Hint="Find station using PointFinder"
		AutomationProperties.HelpText="Find"
        Clicked="OnFindClicked"
      />
	</Grid>
  </Grid>
</ContentPage>
