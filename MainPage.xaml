<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DDepartures"
             x:Class="DDepartures.MainPage">

    <ContentPage.BindingContext>
        <local:RestService />
    </ContentPage.BindingContext>
    <Grid
        RowDefinitions="Auto, *, Auto, Auto"
        ColumnDefinitions="*"
        RowSpacing="8"
        Padding="0,0,0,0"
        BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">

        <Grid Grid.Row="0"
            x:Name="TopRow"
            RowDefinitions="Auto"
            ColumnDefinitions="*">
            <Image Grid.Column="0"
                Source="vvologo.png"
                HeightRequest="32"
                Aspect="AspectFit"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                SemanticProperties.Description="vvo logo" />
        </Grid>
        <RefreshView
                    x:Name="RefView"
                    Grid.Row="1"
                    Padding="16,0,16,0"
                    IsRefreshing="False"
                    Focused="OnUnfocused"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type local:MainPage}}, Path=RefreshCommand}">
            <CollectionView
                    x:Name="DepartureListView"
                    Focused="OnUnfocused"
                    ItemsSource="{Binding Responses}"
                    SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnUnfocused"
                                    Buttons="Primary, Secondary"
                                    NumberOfTapsRequired="1" />
                            </Grid.GestureRecognizers>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1"/>
                            </Grid.RowDefinitions>
                            <Grid
                                     Grid.Row="0"
                                     Padding="0,4,0,4">
                                <Label
                                        FontFamily="monospace"
                                        Text="{Binding .}" />
                            </Grid>
                            <BoxView
                                    Grid.Row="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <Grid Grid.Row="2"
              Padding="16,4,16,0"
              ColumnSpacing="8"
              ColumnDefinitions="Auto, *">
            <Label Grid.Column="0"
                   FontSize="12"
                   Text="Status:" />
            <Label Grid.Column="1"
                   FontSize="12"
                   FontAttributes="Bold"
                   x:Name="StatusLabel" />
        </Grid>
        <Grid Grid.Row="3"
              Padding="8,0,8,8"
              ColumnSpacing="8"
              x:Name="BottomRow"
              RowDefinitions="Auto"
              ColumnDefinitions="*, Auto">
            <Entry Grid.Column="0"
                x:Name="SearchEntry"
                SemanticProperties.Hint="Station"
                ClearButtonVisibility="WhileEditing"
                Placeholder="Stop name or ID"
                ReturnType="Search"
                Completed="OnSearchClicked"
                Unfocused="OnUnfocused"/>
            <Button Grid.Column="1"
                x:Name="SearchBtn"
                Text="Search"
                SemanticProperties.Hint="Look for departures at station"
                Clicked="OnSearchClicked" />
        </Grid>
    </Grid>
</ContentPage>
