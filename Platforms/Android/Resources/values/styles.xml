<?xml version="1.0" encoding="utf-8"?>
<resources>

  <!-- Common widget departure row -->
  <style name="DepartureRow" parent="@android:style/Widget.TextView">
	<item name="android:layout_height">match_parent</item>
	<item name="android:gravity">center_vertical</item>
	<item name="android:textSize">12sp</item>
	<item name="android:textColor">@android:color/white</item>
  </style>


  <style name="DepartureLine" parent="DepartureRow">
	<item name="android:layout_width">50dp</item>
	<item name="android:textStyle">bold</item>
	<item name="android:fontFamily">monospace</item>
  </style>


  <style name="DepartureMode" parent="DepartureRow">
	<item name="android:layout_width">40dp</item>
  </style>


  <style name="DepartureDestination" parent="DepartureRow">
	<item name="android:layout_width">0dp</item>
	<item name="android:layout_weight">1</item>
	<item name="android:singleLine">true</item>
	<item name="android:ellipsize">end</item>
  </style>


  <style name="DepartureTime" parent="DepartureRow">
	<item name="android:layout_width">40dp</item>
	<item name="android:gravity">center_vertical|right</item>
	<item name="android:textStyle">bold</item>
	<item name="android:fontFamily">monospace</item>
  </style>

</resources>